# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# MediaMTX local (binario + config con credenciales reales de la cámara) —
# ver camaras/mediamtx.yml para la plantilla sin credenciales que sí se versiona.
/camaras/mediamtx/
/camaras/ffmpeg/
/camaras/cloudflared/
